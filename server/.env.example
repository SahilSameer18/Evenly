# Pooled connection (used by the running app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.neon.tech/neondb?sslmode=require
# Direct connection (used by prisma migrate)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.region.neon.tech/neondb?sslmode=require
# Signs access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Separate Neon branch for database tests (tests wipe every table; never the dev database)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.neon.tech/neondb?sslmode=require
